# Supabase (Step 2 — operator creates the project, §6.1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for working application rate limits. No Supabase counter fallback exists.
# Missing keys or Redis errors permit requests and log a server error (accepted fail-open policy).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hospital finder (Step 11 — Google Places; leave empty for the OpenStreetMap fallback)
GOOGLE_PLACES_API_KEY=

# AI chatbot (optional Step 19 — Groq)
GROQ_API_KEY=
