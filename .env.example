# Supabase (Step 2 — operator creates the project, §6.1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for working application rate limits. No Supabase counter fallback exists.
# Missing keys or Redis errors permit requests and log a server error (accepted fail-open policy).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth (Step 7). Reference copies only: the app never reads these.
# The live pair belongs in Supabase Dashboard → Authentication → Providers →
# Google, and Google Cloud Console needs the authorized redirect URI
# https://<project-ref>.supabase.co/auth/v1/callback. See
# docs/supabase-auth-settings.md before enabling it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hospital finder is deferred to optional Step 21. Unused until a provider is selected.
GOOGLE_PLACES_API_KEY=

# AI chatbot (optional Step 19 — Groq)
GROQ_API_KEY=
